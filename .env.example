# Local development credentials — copy to .env and adjust if needed.
# Never commit .env with real secrets.

POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=workpulsetracker
POSTGRES_USER=workpulsetracker
POSTGRES_PASSWORD=workpulsetracker

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/workpulsetracker
SPRING_DATASOURCE_USERNAME=workpulsetracker
SPRING_DATASOURCE_PASSWORD=workpulsetracker

# Frontend origin for CORS
APP_UI_ORIGIN=http://localhost:5173
SERVER_PORT=8080

# Folder with installer binaries (relative to tracker-server working directory).
# Prefer running the server from repo root, or set an absolute path.
DOWNLOAD_DIRECTORY=downloads

# Public download URLs returned by GET /api/downloads (and used on the landing page)
DOWNLOAD_WINDOWS_URL=/downloads/workpulsetracker-agent-windows.zip
DOWNLOAD_MACOS_URL=/downloads/workpulsetracker-agent-macos.dmg
DOWNLOAD_LINUX_URL=/downloads/workpulsetracker-agent-linux.deb
