# Local development credentials — copy to .env and adjust if needed.
# Never commit .env with real secrets.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=timetracker
POSTGRES_USER=timetracker
POSTGRES_PASSWORD=timetracker_dev_password

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/timetracker
SPRING_DATASOURCE_USERNAME=timetracker
SPRING_DATASOURCE_PASSWORD=timetracker_dev_password

# Google OAuth (Web client) — fill after creating credentials in Google Cloud Console
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Frontend origin for CORS + post-login redirect
APP_UI_ORIGIN=http://localhost:5173
SERVER_PORT=8080

# Placeholder download URLs for landing page
DOWNLOAD_WINDOWS_URL=/downloads/timetracker-agent-windows.msi
DOWNLOAD_MACOS_URL=/downloads/timetracker-agent-macos.dmg
DOWNLOAD_LINUX_URL=/downloads/timetracker-agent-linux.deb
